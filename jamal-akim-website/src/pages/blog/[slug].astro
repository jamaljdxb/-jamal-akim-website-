---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, metaDescription, publishDate, updatedDate, faq } = entry.data;
const url = new URL(`/blog/${entry.id}`, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: metaDescription,
    datePublished: publishDate.toISOString(),
    dateModified: (updatedDate ?? publishDate).toISOString(),
    author: { '@type': 'Person', name: 'Jamal Akim', url: Astro.site?.href },
    mainEntityOfPage: url,
  },
  ...(faq.length ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  }] : []),
];
---
<BaseLayout
  title={title}
  description={metaDescription}
  canonicalPath={`/blog/${entry.id}`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="article-header wrap">
    <div class="card-eyebrow">{category}</div>
    <h1>{title}</h1>
    <p class="article-meta">
      Published {publishDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      {updatedDate && ` · Updated ${updatedDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}`}
    </p>
  </section>

  <section class="wrap">
    <div class="prose">
      <Content />
      {faq.length > 0 && (
        <>
          <h2>Questions people ask me</h2>
          <div class="faq">
            {faq.map(({ q, a }) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </>
      )}
    </div>
    <aside class="bridge-cta">
      <div class="card-eyebrow">The bridge</div>
      <h3>Latin America to the UAE, with someone who has walked both routes</h3>
      <p>My network across Latin America and the Caribbean keeps growing. If you are weighing a move, a purchase or a business here, message me and I will tell you straight what I would do.</p>
      <div class="hero-actions">
        <a href="https://wa.me/971585570911" target="_blank" rel="noopener" class="btn-primary">Message on WhatsApp ↗</a>
        <a href="/latin-america" class="btn-outline">How I work with LatAm investors</a>
      </div>
    </aside>
    <p style="margin-top: 28px;">
      <a href="/blog" class="btn-outline">← Back to all insights</a>
    </p>
  </section>
</BaseLayout>
